{
  "schemaVersion": 1,
  "id": "io.github.diegopluna.argus",
  "name": "Argus",
  "version": "0.3.0",
  "author": "Diego Peter",
  "license": "MIT",
  "description": "CPU, RAM, GPU, disk, network, battery, and temperature stats in the bar, with sparkline history, top processes, urgent-threshold highlighting, and a full system panel.",
  "kinds": [
    "bar-widget"
  ],
  "barWidget": {
    "displayName": "Argus",
    "description": "Pick which system stats (CPU, RAM, GPU, disk, network, battery, temperatures) appear in the bar — reorderable, urgent-colored past thresholds; click for the full panel.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "show": ["cpu", "ram", "cputemp"],
      "intervalSec": 2,
      "diskMount": "/"
    },
    "schema": [
      {
        "key": "intervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "diskMount",
        "type": "string",
        "label": "Disk mount for the bar metric",
        "defaultValue": "/",
        "description": "Mount point whose usage the bar's disk metric shows."
      },
      {
        "key": "urgentCpuPct",
        "type": "integer",
        "label": "Urgent above: CPU/GPU usage (%)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 90
      },
      {
        "key": "urgentMemPct",
        "type": "integer",
        "label": "Urgent above: RAM/VRAM usage (%)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 90
      },
      {
        "key": "urgentTempC",
        "type": "integer",
        "label": "Urgent above: temperature (°C)",
        "min": 50,
        "max": 110,
        "step": 5,
        "defaultValue": 85
      },
      {
        "key": "urgentDiskPct",
        "type": "integer",
        "label": "Urgent above: disk usage (%)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 90
      }
    ]
  },
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  }
}
